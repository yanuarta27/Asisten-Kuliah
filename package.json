{
  "name": "asisten-kuliah",
  "version": "1.0.0",
  "description": "Asisten kuliah: kelola materi, tugas, dan to-do per mata kuliah.",
  "main": "main.js",
  "author": "Asisten Kuliah contributors",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.asistenkuliah",
    "productName": "Asisten Kuliah",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "renderer/**/*", "build/icon.png"],
    "electronLanguages": ["en-US", "id"],
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "Asisten Kuliah",
      "deleteAppDataOnUninstall": false
    }
  }
}
